o<manuell_atc> sub

    (Gewuenschtes Werkzeug vor dem nativen M6 sichern)
    #<requested_tool> = #<_selected_tool>

    (Native M6 ausfuehren)
    (Oeffnet den Probe-Basic Toolchange-Dialog)
    M6

    (Bei T0 ist nach dem Werkzeugwechsel absichtlich kein Werkzeug eingespannt)
    (Daher weder Tool-Sensor auf "Werkzeug vorhanden" pruefen noch vermessen)
    o100 if [#<requested_tool> NE 0]

        (Pruefen ob Werkzeug nach Bestaetigung tatsaechlich eingespannt ist)
        M66 P11 L0

        o110 if [#5399 EQ 0]
            (abort, TOOL CHANGE ERROR: No tool in spindle after M6!)
        o110 endif
        
        (Air Return fuer 3 Sekunden einschalten um Werkzeug zu spannen)
        M64 P2
        G4 P3
        M65 P2
        
        (Clean TLS)
        M64P4
        G4P1.5
        M65P4
        
        (Werkzeuglaenge vermessen)
        #2000 = 0
        o<tool_touch_off> call

    o100 endif

o<manuell_atc> endsub

M2
